{
  "info": {
    "_postman_id": "3be935cc-ef35-4d7a-ab1c-e5f8dc07123a",
    "name": "Smart Employee & Project Management System API",
    "description": "Postman Collection for querying user auth, employees CRUD, projects, board tasks, and exports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2. Forgot Password Request (OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@company.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "3. Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@company.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "4. Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@company.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewSecPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Employees (Admin)",
      "item": [
        {
          "name": "Get Employee Directory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees?page=0&size=10&sortBy=name&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "name" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create Employee (With Profile Photo Multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Jane Doe", "type": "text" },
                { "key": "email", "value": "janedoe@company.com", "type": "text" },
                { "key": "password", "value": "JanePassword@123", "type": "text" },
                { "key": "department", "value": "Engineering", "type": "text" },
                { "key": "designation", "value": "Developer", "type": "text" },
                { "key": "phoneNumber", "value": "+123456789", "type": "text" },
                { "key": "file", "description": "Profile picture upload file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get User Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E-Commerce App\",\n  \"key\": \"ECOM\",\n  \"description\": \"Development of shopping platform website\",\n  \"priority\": \"HIGH\",\n  \"deadline\": \"2026-12-31\",\n  \"memberIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        }
      ]
    },
    {
      "name": "Issues & Tasks",
      "item": [
        {
          "name": "Get Board Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/issues/project/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues", "project", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Update Task Status (Drag & Drop)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/issues/{{issueId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues", "{{issueId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports & Exports",
      "item": [
        {
          "name": "Export Report to Excel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/export/excel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "export", "excel"]
            }
          }
        },
        {
          "name": "Export Report to PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/export/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "export", "pdf"]
            }
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "your_project_uuid_here",
      "type": "string"
    },
    {
      "key": "issueId",
      "value": "your_issue_uuid_here",
      "type": "string"
    }
  ]
}
